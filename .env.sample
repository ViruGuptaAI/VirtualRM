# ─── Azure Voice Live API (STT + TTS endpoint) ──────────────────────────────
AZURE_VOICE_LIVE_ENDPOINT=https://<your-voice-live-foundry>.services.ai.azure.com
AZURE_VOICE_LIVE_API_KEY=<your-api-key>
VOICE_LIVE_MODEL=gpt-4.1

# ─── BYO LLM (optional — use when LLM is on a different Foundry resource) ───
# Profiles: byom-azure-openai-chat-completion | byom-azure-openai-realtime
#            byom-foundry-anthropic-messages | "" (managed, default)
# Example: Voice Live on Central India, LLM on South India
#   BYOM_PROFILE=byom-azure-openai-chat-completion
#   FOUNDRY_RESOURCE_OVERRIDE=https://<your-llm-foundry>.services.ai.azure.com
BYOM_PROFILE=
FOUNDRY_RESOURCE_OVERRIDE=

# ─── Azure Managed Identity (for Container Apps / App Service) ───────────────
AZURE_USER_ASSIGNED_IDENTITY_CLIENT_ID=

# ─── App Settings ────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
