# ─── Azure Voice Live API (STT + TTS endpoint) ──────────────────────────────
AZURE_VOICE_LIVE_ENDPOINT=https://<your-voice-live-foundry>.services.ai.azure.com
AZURE_VOICE_LIVE_API_KEY=<your-api-key>
VOICE_LIVE_MODEL=gpt-4.1-mini

# ─── BYO LLM (optional — use when LLM is on a different Foundry resource) ───
# Deployment Modes:
#   Default mode: Model deployed on the same Foundry as Voice Live.
#                 Leave BYOM_PROFILE and FOUNDRY_RESOURCE_OVERRIDE empty.
#   BYOM mode:    Model on a separate Foundry resource (e.g., different region).
#                 Set both BYOM_PROFILE and FOUNDRY_RESOURCE_OVERRIDE.
#
# Profiles: byom-azure-openai-chat-completion | byom-azure-openai-realtime
#            byom-foundry-anthropic-messages | "" (managed, default)
# Example: Voice Live on Central India, LLM on South India
#   BYOM_PROFILE=byom-azure-openai-chat-completion
#   FOUNDRY_RESOURCE_OVERRIDE=<your-llm-foundry-resource-name>
# Note: Use just the resource name (e.g., "ai-myenv-llm"), NOT the full URL.
BYOM_PROFILE=
FOUNDRY_RESOURCE_OVERRIDE=

# ─── Azure Managed Identity (for Container Apps / App Service) ───────────────
AZURE_USER_ASSIGNED_IDENTITY_CLIENT_ID=

# ─── ACS inbound telephony (provisioned automatically by azd) ────────────────
ACS_TELEPHONY_ENABLED=false
ACS_ENDPOINT=https://<your-acs-resource>.communication.azure.com
ACS_RESOURCE_ID=/subscriptions/<subscription>/resourceGroups/<group>/providers/Microsoft.Communication/communicationServices/<name>
ACS_CALLBACK_BASE_URL=https://<your-app>.azurecontainerapps.io
ACS_CALL_STATE_TABLE_ENDPOINT=https://<storage-account>.table.core.windows.net
ACS_CALL_STATE_TABLE_NAME=acscallstate

# ─── App Settings ────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
